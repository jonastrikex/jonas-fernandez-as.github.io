---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionBand from '@/components/SectionBand.astro';
import { site } from '@/data/site';

const rows = [
  site.socials.linkedin,
  site.socials.github,
  site.socials.x,
  site.socials.htb,
  site.socials.youtube,
  site.socials.email,
];
---
<BaseLayout path="/contact" title="Contact — Jonas Fernandez" description="Open to penetration testing, red team, SOC, blue team, and IT opportunities.">
  <div style="padding-top: 88px;">
    <SectionBand num="08" label="Contact" title="Get in touch" meta="Reply &lt;24h" />
  </div>

  <div class="container section-body">
    <p class="section-desc rv">Open to penetration testing, red team, SOC, blue team, and any IT opportunity worth pursuing.</p>

    <div class="contact-list rv">
      {rows.map(r => (
        <a class="contact-row" href={r.url} target="_blank" rel="noopener">
          <span class="contact-lbl">{r.label}</span>
          <span class="contact-val">{r.value}</span>
          <span class="contact-arrow">↗</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
